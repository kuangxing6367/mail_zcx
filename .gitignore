# 环境本地配置（含真实凭据，请勿提交到版本库）
config/config.local.php
# 控制台「系统设置」生成，含 cron_token 等，同样不入库
config/config.overrides.php
config/config.overrides.php.bak
config/config.overrides.php.*.tmp

# 运行时产物
storage/logs/*
storage/certs/*
storage/cache/*
!storage/logs/.gitkeep

# 插件启用状态与插件私有数据（每个部署各自维护）
storage/plugins.json
storage/plugins.json.tmp
storage/plugins.lock
storage/plugins/*

# 编辑器
.idea/
.vscode/
*.swp
.DS_Store

# 文档站（VitePress）
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# 本地工作笔记/记忆
.workbuddy/
